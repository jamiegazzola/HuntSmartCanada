rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──
    // Read your own doc, OR read another user's doc if you are in their friends array.
    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.uid in resource.data.friends
      );
      // Existing profile data remains user-writable. Billing authority must NOT rely
      // on user-editable fields in this document.
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── RevenueCat entitlement mirror ──
    // A signed-in user may read their own mirrored entitlement state, but browser
    // clients can never create/update/delete it. Firebase Admin / Cloud Functions
    // write this collection outside client security rules.
    match /billingEntitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── RevenueCat webhook idempotency records ──
    match /revenuecatEvents/{eventId} {
      allow read, write: if false;
    }

    // ── Friend Requests ──
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to
      );
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.from &&
        request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.to ||
        request.auth.uid == resource.data.from
      );
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.from;
    }

  }
}
